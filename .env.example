DATABASE_URL="postgresql://socialops:socialops@localhost:54329/socialops?schema=public"
APP_BASE_URL="http://localhost:3000"
SESSION_COOKIE_NAME="socialops_session"
SESSION_TTL_HOURS="168"
COOKIE_SECURE="false"
SEED_OPERATOR_EMAIL="operator@example.local"
SEED_OPERATOR_PASSWORD="change-this-local-password"
# Production fixture/demo seed is denied unless this is explicitly set to true.
ALLOW_PRODUCTION_SEED="false"
STORAGE_LOCAL_ROOT="./storage"
STORAGE_PROVIDER="local"
MAX_UPLOAD_BYTES="209715200"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_SESSION_TOKEN=""
FFPROBE_PATH="ffprobe"
FFPROBE_TIMEOUT_MS="15000"
WORKER_ID="local-worker"
WORKER_POLL_MS="2000"
JOB_LOCK_TIMEOUT_SECONDS="60"
WORKER_HEARTBEAT_MS="10000"
TEXT_MODEL_BASE_URL=""
TEXT_MODEL_API_KEY=""
TEXT_MODEL_NAME=""
TEXT_MODEL_MAX_OUTPUT_UNITS="2000"
LOGIN_MAX_FAILURES="5"
LOGIN_WINDOW_SECONDS="900"
LOGIN_BLOCK_SECONDS="900"

# 32-byte base64 or 64-character hex key. Generate locally and never commit the value.
TOKEN_ENCRYPTION_KEY=""
TOKEN_ENCRYPTION_KEY_VERSION="v1"

# Meta OAuth (primary V2 connection path)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/connections/meta/callback"
META_LOGIN_CONFIG_ID=""
META_OAUTH_SCOPES="pages_show_list,pages_manage_posts,pages_read_engagement,pages_read_user_content,instagram_basic,instagram_content_publish"
META_GRAPH_API_VERSION="v26.0"
META_AUTH_BASE_URL="https://www.facebook.com"
META_GRAPH_BASE_URL="https://graph.facebook.com"
META_REQUEST_TIMEOUT_MS="30000"
# Only metrics verified for the selected Page and current Graph API version.
META_PAGE_METRIC_KEYS=""

# Legacy V1 manual Page connection fallback
