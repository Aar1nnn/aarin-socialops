generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientMode {
  DEMO
  DRAFT
  LIVE
}

enum SocialStrategyStatus {
  DRAFT
  CONFIRMED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  OPERATOR
  VIEWER
}

enum FactStatus {
  CONFIRMED
  PROPOSED
  MISSING
}

enum AssetKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum AssetVariant {
  ORIGINAL
  DERIVED
}

enum CapabilityStatus {
  UNCONFIGURED
  UNVERIFIED
  VERIFIED
  UNSUPPORTED
}

enum ContentStatus {
  DRAFT
  REVIEW_PENDING
  APPROVED
  CHANGES_REQUESTED
  SCHEDULED
  RUNNING
  PUBLISHED
  WAITING_CONFIGURATION
  FAILED
  UNKNOWN
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum PublishJobStatus {
  PENDING
  RUNNING
  RETRY
  WAITING_CONFIGURATION
  PUBLISHED
  FAILED
  UNKNOWN
  CANCELLED
}

enum AttemptStatus {
  DISPATCHING
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum PublishEnvironment {
  SIMULATED
  LIVE
}

enum Provider {
  META
  LINKEDIN
  TIKTOK
  GOOGLE
}

enum PlatformConnectionStatus {
  CONNECTING
  CONNECTED
  TOKEN_EXPIRING
  TOKEN_EXPIRED
  PERMISSION_MISSING
  REVIEW_REQUIRED
  DISCONNECTED
  ERROR
}

enum FacebookTokenStatus {
  UNCONFIGURED
  UNVERIFIED
  VALID
  EXPIRING
  EXPIRED
  REVOKED
  UNKNOWN
}

enum UsageReservationStatus {
  RESERVED
  SETTLED
  RELEASED
  EXPIRED
}

enum DataAvailability {
  AVAILABLE
  NOT_FETCHED
  UNSUPPORTED
  PERMISSION_DENIED
  READ_FAILED
}

enum DataKind {
  REAL
  MOCK
}

enum LeadCategory {
  PROCUREMENT
  WHOLESALE
  INQUIRY
  CATALOG_REQUEST
  SUPPLY_REQUEST
  GENERAL
  SPAM
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LeadHandoffStatus {
  NEW
  REPLIED
  HANDED_OFF
  WAITING_FEEDBACK
  CLOSED
  DISMISSED
}

enum ManualTaskStatus {
  TODO
  IN_PROGRESS
  WAITING_EXTERNAL
  COMPLETED
  CANCELLED
}

enum ManualTaskPriority {
  NORMAL
  HIGH
  URGENT
}

enum NotificationSeverity {
  NORMAL
  URGENT
}

enum AnalyticsFreshnessStatus {
  FRESH
  STALE
  SYNCING
  FAILED
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum IntegrationType {
  TEXT_GENERATION
  IMAGE_GENERATION
  SOCIAL_PUBLISHING
  METRICS
  INTERACTIONS
  NOTIFICATION
  WORDPRESS
  OBJECT_STORAGE
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  displayName         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         ClientMembership[]
  sessions            Session[]
  approvals           Approval[]
  createdContentVersions ContentVersion[] @relation("ContentVersionCreator")
  reviewComments      ReviewComment[]
  auditLogs           AuditLog[]
  platformConnections PlatformConnection[]
  oauthStates         OAuthState[]
  createdStrategies   SocialStrategy[] @relation("SocialStrategyCreator")
  confirmedStrategies SocialStrategy[] @relation("SocialStrategyConfirmer")
}

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  activeClientId String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeClient   Client   @relation(fields: [activeClientId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Client {
  id                     String                   @id @default(cuid())
  slug                   String                   @unique
  name                   String
  mode                   ClientMode               @default(DEMO)
  timezone               String                   @default("Asia/Shanghai")
  targetMarkets          String[]                 @default([])
  productFocus           String?
  brandGuidelines        String?
  contactDetails         Json?
  usageMonthlyLimit      Int                      @default(100000)
  isDemo                 Boolean                  @default(false)
  configurationStatus    String                   @default("PENDING")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  memberships            ClientMembership[]
  sessions               Session[]
  products               Product[]
  assets                 Asset[]
  assetTags              AssetTag[]
  scheduleQueues         ScheduleQueue[]
  scheduleSlots          ScheduleSlot[]
  accounts               SocialAccount[]
  platformPolicies       PlatformPolicy[]
  contentPlans           ContentPlan[]
  socialStrategies       SocialStrategy[]
  contentItems           ContentItem[]
  contentVersions        ContentVersion[]
  approvals              Approval[]
  reviewComments         ReviewComment[]
  publishJobs            PublishJob[]
  publishAttempts        PublishAttempt[]
  metricSnapshots        MetricSnapshot[]
  interactions           Interaction[]
  leads                  Lead[]
  manualTasks            ManualTask[]
  reports                OperationReport[]
  experiments            Experiment[]
  notificationChannels   NotificationChannel[]
  notifications          InAppNotification[]
  integrations           IntegrationConfig[]
  promptVersions         PromptVersion[]
  auditLogs              AuditLog[]
  usageLogs              UsageLog[]
  researchRecords        ResearchRecord[]
  facebookConnections    FacebookPageConnection[]
  usageReservations      UsageReservation[]
  platformConnections    PlatformConnection[]
  oauthStates            OAuthState[]
  brandProfile           BrandProfile?
  analyticsSyncStates    AnalyticsSyncState[]
  notificationDeliveries NotificationDelivery[]
  notificationRules      NotificationRule[]
}

model BrandProfile {
  id               String   @id @default(cuid())
  clientId         String   @unique
  businessSummary  String?
  positioning      String?
  audience         String?
  tone             String?
  voiceTraits      String[] @default([])
  goals            String[] @default([])
  contentLanguages String[] @default([])
  imageStyle       String?
  bannedPhrases    String[] @default([])
  requiredMentions String[] @default([])
  ctaRules         String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model SocialStrategy {
  id                String               @id @default(cuid())
  clientId          String
  version           Int
  status            SocialStrategyStatus @default(DRAFT)
  payload           Json
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  createdByUserId   String
  confirmedByUserId String?
  confirmedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy         User                 @relation("SocialStrategyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedBy       User?                @relation("SocialStrategyConfirmer", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  contentPlans      ContentPlan[]

  @@unique([clientId, version])
  @@unique([id, clientId])
  @@index([clientId, status, createdAt])
}

model ResearchRecord {
  id           String   @id @default(cuid())
  clientId     String
  kind         String
  objective    String
  sourceUrl    String?
  observedAt   DateTime
  observations Json
  inferences   Json
  experiments  Json
  limitations  Json
  createdAt    DateTime @default(now())
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, kind, observedAt])
}

model ClientMembership {
  id        String         @id @default(cuid())
  userId    String
  clientId  String
  role      MembershipRole @default(OPERATOR)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
}

model Product {
  id          String         @id @default(cuid())
  clientId    String
  name        String
  modelNumber String?
  dataVersion Int            @default(1)
  status      FactStatus     @default(PROPOSED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fields      ProductField[]
  assetLinks  ProductAsset[]
  plans       ContentPlan[]

  @@index([clientId, updatedAt])
}

model ProductField {
  id        String     @id @default(cuid())
  clientId  String
  productId String
  key       String
  value     String?
  status    FactStatus
  source    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([clientId, status])
}

model Asset {
  id              String                @id @default(cuid())
  clientId        String
  parentAssetId   String?
  kind            AssetKind
  variant         AssetVariant          @default(ORIGINAL)
  originalName    String
  mimeType        String
  byteSize        Int
  storageProvider String                @default("local")
  storageKey      String
  checksum        String
  metadata        Json?
  createdAt       DateTime              @default(now())
  client          Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  parentAsset     Asset?                @relation("AssetDerivatives", fields: [parentAssetId], references: [id], onDelete: SetNull)
  derivatives     Asset[]               @relation("AssetDerivatives")
  productLinks    ProductAsset[]
  contentLinks    ContentVersionAsset[]
  tagLinks        AssetTagLink[]

  @@unique([clientId, checksum, storageKey])
  @@unique([id, clientId])
  @@index([clientId, createdAt])
}

model AssetTag {
  id             String         @id @default(cuid())
  clientId       String
  name           String
  normalizedName String
  createdAt      DateTime       @default(now())
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assetLinks     AssetTagLink[]

  @@unique([clientId, normalizedName])
  @@unique([id, clientId])
  @@index([clientId, name])
}

model AssetTagLink {
  assetId  String
  tagId    String
  clientId String
  createdAt DateTime @default(now())
  asset    Asset    @relation(fields: [assetId, clientId], references: [id, clientId], onDelete: Cascade)
  tag      AssetTag @relation(fields: [tagId, clientId], references: [id, clientId], onDelete: Cascade)

  @@id([assetId, tagId])
  @@index([clientId, tagId])
}

model ProductAsset {
  productId String
  assetId   String
  clientId  String
  relation  String   @default("PRODUCT_MEDIA")
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([productId, assetId])
  @@index([clientId])
}

model SocialAccount {
  id                    String                  @id @default(cuid())
  clientId              String
  platform              String
  displayName           String
  externalAccountId     String?
  credentialRef         String?
  platformConnectionId  String?
  accountType           String?
  username              String?
  metadata              Json?
  providerCapabilities  Json?
  isSelected            Boolean                 @default(true)
  accessTokenCiphertext String?
  accessTokenIv         String?
  accessTokenAuthTag    String?
  accessTokenExpiresAt  DateTime?
  publishCapability     CapabilityStatus        @default(UNCONFIGURED)
  metricsCapability     CapabilityStatus        @default(UNCONFIGURED)
  commentsCapability    CapabilityStatus        @default(UNCONFIGURED)
  messagesCapability    CapabilityStatus        @default(UNCONFIGURED)
  groupsCapability      CapabilityStatus        @default(UNCONFIGURED)
  verifiedAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  client                Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentItems          ContentItem[]
  approvals             Approval[]
  publishJobs           PublishJob[]
  metricSnapshots       MetricSnapshot[]
  interactions          Interaction[]
  facebookConnection    FacebookPageConnection?
  platformConnection    PlatformConnection?     @relation(fields: [platformConnectionId, clientId], references: [id, clientId], onDelete: Restrict)
  scheduleQueues         ScheduleQueue[]

  @@unique([clientId, platform, externalAccountId])
  @@unique([id, clientId])
  @@index([clientId, platform])
  @@index([platformConnectionId])
}

model PlatformConnection {
  id                     String                   @id @default(cuid())
  clientId               String
  provider               Provider
  externalPrincipalId    String?
  accessTokenCiphertext  String?
  accessTokenIv          String?
  accessTokenAuthTag     String?
  refreshTokenCiphertext String?
  refreshTokenIv         String?
  refreshTokenAuthTag    String?
  tokenKeyVersion        String                   @default("v1")
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scopes                 String[]                 @default([])
  status                 PlatformConnectionStatus @default(CONNECTING)
  connectedByUserId      String
  connectedAt            DateTime?
  lastRefreshedAt        DateTime?
  lastErrorCode          String?
  lastErrorMessage       String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  client                 Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  connectedBy            User                     @relation(fields: [connectedByUserId], references: [id], onDelete: Restrict)
  accounts               SocialAccount[]

  @@unique([id, clientId])
  @@unique([clientId, provider, externalPrincipalId])
  @@index([clientId, provider, status])
}

model OAuthState {
  id                     String    @id @default(cuid())
  stateHash              String    @unique
  provider               Provider
  clientId               String
  userId                 String
  redirectUri            String
  returnTo               String?
  codeVerifierCiphertext String?
  codeVerifierIv         String?
  codeVerifierAuthTag    String?
  expiresAt              DateTime
  consumedAt             DateTime?
  createdAt              DateTime  @default(now())
  client                 Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, provider, expiresAt])
  @@index([userId, expiresAt])
}

model PlatformPolicy {
  id             String    @id @default(cuid())
  clientId       String
  platform       String
  maxTextLength  Int?
  allowedFormats String[]  @default([])
  source         String
  verifiedAt     DateTime?
  config         Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, platform])
}

model PromptVersion {
  id              String           @id @default(cuid())
  clientId        String
  capability      String
  version         String
  instruction     String
  schemaName      String
  modelConfig     Json
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentVersions ContentVersion[]

  @@unique([clientId, capability, version])
}

model ContentPlan {
  id             String        @id @default(cuid())
  clientId       String
  productId      String?
  socialStrategyId String?
  theme          String
  objective      String
  channels       String[]
  assetNeeds     String?
  plannedAt      DateTime?
  marketScope    String?
  isGenericDraft Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  socialStrategy SocialStrategy? @relation(fields: [socialStrategyId, clientId], references: [id, clientId], onDelete: Restrict)
  items          ContentItem[]

  @@index([clientId, plannedAt])
  @@index([socialStrategyId, clientId])
}

model ContentItem {
  id               String           @id @default(cuid())
  clientId         String
  planId           String
  accountId        String
  platform         String
  currentVersionId String?          @unique
  status           ContentStatus    @default(DRAFT)
  scheduledAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan             ContentPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  account          SocialAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  versions         ContentVersion[] @relation("ItemVersions")
  currentVersion   ContentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  reviewComments   ReviewComment[]

  @@unique([planId, accountId])
  @@unique([id, clientId])
  @@index([clientId, status])
}

model ScheduleQueue {
  id          String         @id @default(cuid())
  clientId    String
  accountId   String
  name        String
  timezone    String
  enabled     Boolean        @default(true)
  horizonDays Int            @default(30)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account     SocialAccount  @relation(fields: [accountId, clientId], references: [id, clientId], onDelete: Cascade)
  slots       ScheduleSlot[]

  @@unique([clientId, accountId, name])
  @@unique([id, clientId])
  @@index([clientId, enabled])
}

model ScheduleSlot {
  id          String        @id @default(cuid())
  clientId    String
  queueId     String
  dayOfWeek   Int
  hour        Int
  minute      Int           @default(0)
  enabled     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  queue       ScheduleQueue @relation(fields: [queueId, clientId], references: [id, clientId], onDelete: Cascade)

  @@unique([queueId, dayOfWeek, hour, minute])
  @@index([clientId, queueId, enabled])
}

model ContentVersion {
  id                 String                @id @default(cuid())
  clientId           String
  contentItemId      String
  version            Int
  text               String
  title              String?
  productDataVersion Int?
  promptVersionId    String
  generator          String
  simulated          Boolean               @default(false)
  generationLabel    String
  sourceFacts        Json
  previousVersionId  String?
  createdByUserId    String?
  source             String                @default("SYSTEM")
  reason             String?
  createdAt          DateTime              @default(now())
  client             Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  item               ContentItem           @relation("ItemVersions", fields: [contentItemId], references: [id], onDelete: Cascade)
  currentFor         ContentItem[]         @relation("CurrentVersion")
  promptVersion      PromptVersion         @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  previousVersion    ContentVersion?       @relation("ContentVersionLineage", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions       ContentVersion[]      @relation("ContentVersionLineage")
  createdBy          User?                 @relation("ContentVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assetLinks         ContentVersionAsset[]
  approvals          Approval[]
  reviewComments     ReviewComment[]
  publishJobs        PublishJob[]

  @@unique([contentItemId, version])
  @@unique([id, clientId])
  @@index([clientId, createdAt])
  @@index([previousVersionId])
  @@index([createdByUserId, createdAt])
}

model ContentVersionAsset {
  contentVersionId String
  assetId          String
  clientId         String
  createdAt        DateTime       @default(now())
  contentVersion   ContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)
  asset            Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([contentVersionId, assetId])
  @@index([clientId])
}

model Approval {
  id               String           @id @default(cuid())
  clientId         String
  contentVersionId String
  accountId        String
  reviewerId       String
  decision         ApprovalDecision
  note             String?
  createdAt        DateTime         @default(now())
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentVersion   ContentVersion   @relation(fields: [contentVersionId], references: [id], onDelete: Restrict)
  account          SocialAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reviewer         User             @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([clientId, contentVersionId, accountId, createdAt])
}

model ReviewComment {
  id               String         @id @default(cuid())
  clientId         String
  contentItemId    String
  contentVersionId String
  reviewerId       String
  comment          String
  reason           String?
  requestedChanges Json
  createdAt        DateTime       @default(now())
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentItem      ContentItem    @relation(fields: [contentItemId, clientId], references: [id, clientId], onDelete: Cascade)
  contentVersion   ContentVersion @relation(fields: [contentVersionId, clientId], references: [id, clientId], onDelete: Restrict)
  reviewer         User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([clientId, contentItemId, createdAt])
  @@index([clientId, contentVersionId, createdAt])
}

model PublishJob {
  id               String             @id @default(cuid())
  clientId         String
  contentVersionId String
  accountId        String
  provider         Provider?
  platform         String?
  status           PublishJobStatus   @default(PENDING)
  idempotencyKey   String             @unique
  adapter          String
  simulated        Boolean            @default(false)
  environment      PublishEnvironment @default(SIMULATED)
  attemptCount     Int                @default(0)
  maxAttempts      Int                @default(3)
  nextAttemptAt    DateTime           @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  lastErrorCode    String?
  lastErrorMessage String?
  remotePostId     String?
  remotePostUrl    String?
  publishedAt      DateTime?
  lastQueriedAt    DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  client           Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentVersion   ContentVersion     @relation(fields: [contentVersionId], references: [id], onDelete: Restrict)
  account          SocialAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  attempts         PublishAttempt[]
  manualTasks      ManualTask[]

  @@unique([clientId, contentVersionId, accountId])
  @@index([status, nextAttemptAt])
  @@index([clientId, createdAt])
}

model PublishAttempt {
  id                 String        @id @default(cuid())
  clientId           String
  publishJobId       String
  number             Int
  status             AttemptStatus @default(DISPATCHING)
  requestFingerprint String
  errorCode          String?
  errorMessage       String?
  remotePostId       String?
  remotePostUrl      String?
  startedAt          DateTime      @default(now())
  finishedAt         DateTime?
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  publishJob         PublishJob    @relation(fields: [publishJobId], references: [id], onDelete: Cascade)

  @@unique([publishJobId, number])
  @@index([clientId, startedAt])
}

model MetricSnapshot {
  id           String           @id @default(cuid())
  clientId     String
  accountId    String
  metricKey    String
  numericValue Decimal?
  availability DataAvailability
  dataKind     DataKind
  periodStart  DateTime?
  periodEnd    DateTime?
  fetchedAt    DateTime
  source       String
  errorMessage String?
  createdAt    DateTime         @default(now())
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account      SocialAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([clientId, metricKey, fetchedAt])
}

model AnalyticsSyncState {
  id              String                   @id @default(cuid())
  clientId        String
  accountId       String?
  scope           String
  status          AnalyticsFreshnessStatus @default(STALE)
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastFailedAt    DateTime?
  errorMessage    String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  client          Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, accountId, scope])
  @@index([clientId, status, updatedAt])
}

model Interaction {
  id               String         @id @default(cuid())
  clientId         String
  accountId        String?
  platform         String
  platformRecordId String
  interactionType  String
  authorHandle     String?
  authorDisplay    String?
  body             String
  sourceUrl        String?
  occurredAt       DateTime
  importedAt       DateTime       @default(now())
  rawPayload       Json?
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account          SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  lead             Lead?

  @@unique([clientId, platform, platformRecordId])
  @@index([clientId, occurredAt])
}

model Lead {
  id                 String            @id @default(cuid())
  clientId           String
  interactionId      String            @unique
  category           LeadCategory
  priority           LeadPriority
  rationale          String
  relatedProductId   String?
  verificationNeeded String?
  handoffStatus      LeadHandoffStatus @default(NEW)
  salesFeedback      String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  client             Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  interaction        Interaction       @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([clientId, priority, handoffStatus])
}

model ManualTask {
  id                 String             @id @default(cuid())
  clientId           String
  contentItemId      String?
  leadId             String?
  accountId          String?
  publishJobId       String?
  triggerReason      String
  priority           ManualTaskPriority @default(NORMAL)
  suggestedDueAt     DateTime?
  sourceMaterial     Json
  requiredAction     String
  completionCriteria String
  continuationStep   String
  status             ManualTaskStatus   @default(TODO)
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  publishJob         PublishJob?        @relation(fields: [publishJobId], references: [id], onDelete: SetNull)

  @@index([clientId, status, priority])
  @@index([clientId, publishJobId])
}

model OperationReport {
  id              String   @id @default(cuid())
  clientId        String
  periodStart     DateTime
  periodEnd       DateTime
  facts           Json
  dataLimitations Json
  hypotheses      Json
  recommendations Json
  simulated       Boolean  @default(false)
  generatedAt     DateTime @default(now())
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, generatedAt])
}

model Experiment {
  id         String    @id @default(cuid())
  clientId   String
  reportId   String?
  hypothesis String
  metric     String
  status     String    @default("PROPOSED")
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
}

model NotificationChannel {
  id            String                 @id @default(cuid())
  clientId      String
  type          String
  displayName   String
  credentialRef String?
  status        CapabilityStatus       @default(UNCONFIGURED)
  verifiedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  client        Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliveries    NotificationDelivery[]

  @@unique([clientId, type, displayName])
  @@unique([id, clientId])
}

model NotificationRule {
  id              String               @id @default(cuid())
  clientId        String
  eventType       String
  severity        NotificationSeverity
  channelType     String
  enabled         Boolean              @default(true)
  cooldownMinutes Int                  @default(60)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  client          Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, eventType, severity, channelType])
  @@index([clientId, enabled, eventType])
}

model InAppNotification {
  id          String                 @id @default(cuid())
  clientId    String
  severity    NotificationSeverity
  title       String
  body        String
  relatedType String?
  relatedId   String?
  eventType   String                 @default("HIGH_PRIORITY_TASK")
  dedupeKey   String?
  occurrenceCount Int               @default(1)
  lastOccurredAt DateTime            @default(now())
  readAt      DateTime?
  createdAt   DateTime               @default(now())
  client      Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliveries  NotificationDelivery[]

  @@unique([id, clientId])
  @@unique([clientId, dedupeKey])
  @@index([clientId, severity, readAt])
  @@index([clientId, eventType, lastOccurredAt])
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  clientId       String
  notificationId String
  channelId      String
  status         NotificationDeliveryStatus @default(PENDING)
  attemptCount   Int                        @default(0)
  lastError      String?
  deliveredAt    DateTime?
  lockedAt       DateTime?
  lockedBy       String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  client         Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  notification   InAppNotification          @relation(fields: [notificationId, clientId], references: [id, clientId], onDelete: Cascade)
  channel        NotificationChannel        @relation(fields: [channelId, clientId], references: [id, clientId], onDelete: Cascade)

  @@index([notificationId, channelId, createdAt])
  @@index([clientId, status, updatedAt])
  @@index([status, lockedAt, createdAt])
}

model IntegrationConfig {
  id            String           @id @default(cuid())
  clientId      String
  type          IntegrationType
  provider      String
  credentialRef String?
  status        CapabilityStatus @default(UNCONFIGURED)
  publicConfig  Json?
  verifiedAt    DateTime?
  lastError     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, type, provider])
}

model AuditLog {
  id         String   @id @default(cuid())
  clientId   String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
}

model UsageLog {
  id            String   @id @default(cuid())
  clientId      String
  capability    String
  provider      String
  model         String?
  inputUnits    Int      @default(0)
  outputUnits   Int      @default(0)
  estimatedCost Decimal?
  simulated     Boolean  @default(false)
  createdAt     DateTime @default(now())
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model FacebookPageConnection {
  id                  String              @id @default(cuid())
  clientId            String
  accountId           String              @unique
  pageId              String
  pageName            String?
  graphApiVersion     String              @default("v26.0")
  credentialRef       String
  requiredPermissions String[]            @default([])
  grantedPermissions  String[]            @default([])
  pageTasks           String[]            @default([])
  metricKeys          String[]            @default([])
  tokenStatus         FacebookTokenStatus @default(UNVERIFIED)
  tokenExpiresAt      DateTime?
  connectionStatus    CapabilityStatus    @default(UNVERIFIED)
  verifiedAt          DateTime?
  lastCheckedAt       DateTime?
  metricsSyncedAt     DateTime?
  commentsSyncedAt    DateTime?
  commentsCursor      String?
  lastErrorCategory   String?
  lastErrorMessage    String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  client              Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account             SocialAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([clientId, pageId])
  @@index([clientId, connectionStatus])
}

model UsageReservation {
  id            String                 @id @default(cuid())
  clientId      String
  requestKey    String                 @unique
  capability    String
  provider      String
  reservedUnits Int
  settledUnits  Int?
  status        UsageReservationStatus @default(RESERVED)
  expiresAt     DateTime
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  client        Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status, createdAt])
}

model LoginRateLimit {
  keyHash       String    @id
  failureCount  Int       @default(0)
  windowStarted DateTime
  blockedUntil  DateTime?
  lastFailureAt DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([blockedUntil])
}
